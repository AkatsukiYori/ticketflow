generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Users {
  id                Int              @id @default(autoincrement()) @db.UnsignedInt
  username          String           @unique @db.VarChar(150)
  password          String           @db.VarChar(100)
  location          Location         @default(pontianak)
  isActive          Boolean          @default(true)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  deleted_at        DateTime?
  role              RoleUsers        @default(admin)
  log               Log[]
  ticket_feedback   TicketFeedback[]
  tickets           Tickets[]
  kpi_detail        DetailKpi[]

  @@map("users")
}

model Categories {
  id            Int             @id @default(autoincrement()) @db.UnsignedInt
  name          String          @db.VarChar(100)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  deleted_at    DateTime?
  documentation Documentation[]
  tickets       Tickets[]

  @@map("categories")
}

model Tickets {
  id                Int              @id @default(autoincrement()) @db.UnsignedInt
  assign_to         Int?             @db.UnsignedInt
  category_id       Int              @db.UnsignedInt
  department_id     Int?             @db.UnsignedInt
  member_id         Int?             @db.UnsignedInt
  ticket_no         String           @db.VarChar(100)
  ticket_title      String           @db.VarChar(20)
  problem           String           @db.Text
  report_date       DateTime         @default(now())
  location          String           @db.VarChar(50)
  priority          Priority?
  note              String?          @db.VarChar(200)
  status            TicketStatus     @default(pending)
  status_reason     String?          @db.VarChar(100)
  closed_at         DateTime?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  deleted_at        DateTime?
  estimate          DateTime?
  reject_at         DateTime?
  modul             String?          @db.VarChar(100)
  sub_modul         String?          @db.VarChar(100)
  reopened_at       DateTime?
  no_wa             String?          @db.VarChar(20)
  ikb_status_point  String?          @db.VarChar(20)
  expired_at        DateTime?
  programmer        String?          @db.VarChar(255)
  images            Images?
  log               Log[]
  kpi_detail        DetailKpi?
  rating            Rating?
  ticket_feedback   TicketFeedback[]
  fk_users_id       Users?           @relation(fields: [assign_to], references: [id])
  fk_category_id    Categories       @relation(fields: [category_id], references: [id])
  fk_department     Department?      @relation(fields: [department_id], references: [id])
  fk_member         Members?         @relation(fields: [member_id], references: [id])

  @@index([assign_to], map: "tickets_assign_to_fkey")
  @@index([category_id], map: "tickets_category_id_fkey")
  @@index([department_id], map: "tickets_department_id_fkey")
  @@index([member_id], map: "tickets_member_id_fkey")

  @@map("tickets")
}

model TicketFeedback {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  ticket_id    Int      @db.UnsignedInt
  message      String   @db.VarChar(100)
  role         String   @db.VarChar(300)
  user_id      Int?     @db.UnsignedInt
  created_at   DateTime @default(now())
  fk_ticket_id Tickets  @relation(fields: [ticket_id], references: [id])
  fk_admin_id  Users?   @relation(fields: [user_id], references: [id])

  @@index([ticket_id], map: "ticket_feedback_ticket_id_fkey")
  @@index([user_id], map: "ticket_feedback_user_id_fkey")

  @@map("ticket_feedback")
}

model Images {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  ticket_id    Int?     @unique @db.UnsignedInt
  filename     String   @db.VarChar(255)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  file_path    String   @db.VarChar(255)
  mimetypes    String   @db.VarChar(255)
  size         BigInt   @db.BigInt
  fk_ticket_id Tickets? @relation(fields: [ticket_id], references: [id])

  @@index([ticket_id], map: "images_ticket_id_fkey")

  @@map("images")
}

model Log {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  ticket_id    Int      @db.UnsignedInt
  user_id      Int?     @db.UnsignedInt
  status       String   @db.VarChar(100)
  action_type  String   @db.VarChar(100)
  log_date     DateTime @default(now())
  description  String?  @db.VarChar(255)
  auto_closed  Boolean? @default(false)
  closed_by    String?  @db.VarChar(50)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  fk_ticket_id Tickets  @relation(fields: [ticket_id], references: [id])
  fk_user_id   Users?   @relation(fields: [user_id], references: [id])

  @@index([ticket_id], map: "log_ticket_id_fkey")
  @@index([user_id], map: "log_user_id_fkey")

  @@map("log")
}

model Documentation {
  id                  Int                  @id @default(autoincrement()) @db.UnsignedInt
  category_id         Int                  @db.UnsignedInt
  title               String               @db.VarChar(100)
  description         String?              @db.VarChar(300)
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  fk_category_id      Categories           @relation(fields: [category_id], references: [id])
  documentation_files Documentation_files?

  @@index([category_id], map: "documentation_category_id_fkey")

  @@map("documentation")
}

model Documentation_files {
  id             Int            @id @default(autoincrement()) @db.UnsignedInt
  document_id    Int?           @unique @db.UnsignedInt
  filename       String         @db.VarChar(255)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  file_path      String         @db.VarChar(255)
  mimetypes      String         @db.VarChar(255)
  size           BigInt

  fk_document_id Documentation? @relation(fields: [document_id], references: [id])

  @@index([document_id], map: "documentation_files_document_id_fkey")

  @@map("documentation_files")
}

model Rating {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  ticket_id     Int      @unique @db.UnsignedInt
  score         Int      @db.UnsignedTinyInt
  note          String?  @db.VarChar(255)
  created_at    DateTime @default(now())
  fk_tickets_id Tickets  @relation(fields: [ticket_id], references: [id])

  @@index([ticket_id], map: "rating_ticket_id_fkey")

  @@map("rating")
}

model Members {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  username      String    @db.VarChar(255)
  active_status Boolean   @default(true)
  deleted_at    DateTime?
  created_at    DateTime  @default(now())
  tickets       Tickets[]

  @@map("members")
}

model Department {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  name       String    @db.VarChar(255)
  deleted_at DateTime?
  created_at DateTime  @default(now())
  tickets    Tickets[]

  @@map("department")
}

model PushSubscription {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  subscription    Json      @db.Json
  endpoint        String    @db.Text
  endpointHash    String    @unique
  created_at      DateTime  @default(now())

  @@map("push_notification")
}

model kpi {
  id              Int         @id @default(autoincrement()) @db.UnsignedInt
  name            String      @db.Text
  weight          Decimal     @default(0.00) @db.Decimal(12,2)
  year_target     Decimal     @default(0.00) @db.Decimal(8,0)
  target_status   String      @db.VarChar(20) @default("qty")
  formula         String      @db.VarChar(255)
  verificator     String?     @db.VarChar(255)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  deleted_at      DateTime?
  kpi_detail      DetailKpi[]
  kpi_realization RealizationKpi[]
  kpi_description DescriptionKpi[]

  @@map("kpi")
}

model DetailKpi {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  kpi_id        Int       @db.UnsignedInt
  ticket_id     Int       @unique @db.UnsignedInt
  user_id       Int       @db.UnsignedInt
  created_at    DateTime  @default(now())
  deleted_at    DateTime?
  fk_kpi_id     kpi       @relation(fields: [kpi_id], references: [id])
  fk_ticket_id  Tickets   @relation(fields: [ticket_id], references: [id])
  fk_user_id    Users     @relation(fields: [user_id], references: [id])

  @@index([kpi_id], map: "kpi_detail_kpi_id_fkey")
  @@index([ticket_id], map: "kpi_detail_ticket_id_fkey")
  @@index([user_id], map: "kpi_detail_user_id_fkey")

  @@map("kpi_detail")
}

model RealizationKpi {
  id              Int           @id @default(autoincrement()) @db.UnsignedInt
  kpi_id          Int           @db.UnsignedInt
  year            Int           @db.UnsignedSmallInt
  month           Int           @db.UnsignedTinyInt
  target          Decimal       @default(0.00) @db.Decimal(12,0)
  realization     Decimal       @default(0.00) @db.Decimal(12,0)
  score           Decimal       @default(0.00) @db.Decimal(8,2)
  total_score     Decimal       @default(0.00) @db.Decimal(8,2)
  created_at      DateTime      @default(now())
  deleted_at      DateTime?
  fk_kpi_id       kpi           @relation(fields: [kpi_id], references: [id])

  @@index([kpi_id], map: "kpi_realization_kpi_id_fkey")

  @@map("kpi_realization")
}

model DescriptionKpi {
  id              Int           @id @default(autoincrement()) @db.UnsignedInt
  kpi_id          Int           @db.UnsignedInt
  description     String        @db.Text
  created_at      DateTime      @db.Timestamp() @default(now())
  deleted_at      DateTime?
  fk_kpi_id       kpi           @relation(fields: [kpi_id], references: [id])

  @@index([kpi_id], map: "kpi_description_kpi_id_fkey")

  @@map("kpi_description")
}

enum Location {
  pontianak
  jakarta
}

enum Priority {
  high
  mid
  low
}

enum TicketStatus {
  pending
  on_progress
  completed
  reject
}

enum RoleUsers {
  admin
  ikb
  ga
}
